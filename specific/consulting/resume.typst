// --- LAYOUT FUNCTIONS ---
#let section(title) = {
  v(0.5em)
  text(size: 13pt, weight: "bold", fill: rgb("#333333"))[#title]
  line(length: 100%, stroke: 0.5pt + rgb("#666666"))
  v(0.3em)
}

#let entry(title, subtitle, date, location, body) = {
  grid(
    columns: (1fr, auto),
    row-gutter: 0.5em,
    strong(title), align(right)[#date],
    emph(subtitle), align(right)[#emph(location)]
  )
  body
  v(0.5em)
}

// --- EXPERIENCE ---
#section("EXPERIENCE")
#entry(
  "Dassault Systèmes — 3DEXPERIENCE Platform Infrastructure & Cloud",
  [Apprentice Solution Architect Consultant],
  "Sept. 2023 – Present",
  "Meudon, France",
  [
    - *Compliance & Pre-sales:* Drafting of an internal reference document explaining the scope and articulation of ISO 27001/27002/27017/27018 standards, used by the pre-sales team to clarify the company's compliance posture during customer exchanges.
    - *Security & Development:* Development of a security hardening program for the 3DEXPERIENCE On-Premise platform (energy sector client) in Java and Rust. Creation of a health-checking tool: verification of security configurations (TLS, HTTP headers, Referrer filtering, HTTP methods, TomEE AJP listener CVE-2020-1938), detection of known vulnerabilities in client base dependencies, compliance validation of critical components, and report generation.
    - *Deployment & POC:* Installations and testing of the 3DEXPERIENCE OnPremise platform (versions 23x to 26x) with Native Apps on virtual machines (Oracle Linux) for POCs, partner, and customer training. Installation of the license server for demonstrations (e.g., Airbus, Naval Group) or testing.
    - *Documentation:* Update of internal documentation explaining the mechanism of Dassault Systèmes licenses (OnPremise and Cloud).
