// --- FONCTIONS DE MISE EN PAGE ---
#let section(title) = {
  v(0.3em)
  text(size: 12pt, weight: "bold", fill: rgb("#333333"))[#title]
  line(length: 100%, stroke: 0.5pt + rgb("#666666"))
  v(0.2em)
}

#let entry(title, subtitle, date, location, body) = {
  grid(
    columns: (1fr, auto),
    row-gutter: 0.3em,
    strong(title), align(right)[#date],
    emph(subtitle), align(right)[#emph(location)]
  )
  body
  v(0.3em)
}

// --- EXPERIENCE ---
#section("EXPERIENCE")
#entry(
  "Dassault Systèmes — 3DEXPERIENCE Platform Infrastructure & Cloud",
  [Infrastructure & Cybersecurity Apprentice],
  "Sept 2023 – Present",
  "Meudon, France",
  [
    - Authored an *internal reference document* explaining the *scope and articulation of ISO 27001/27002/27017/27018*, used by the *pre-sales team* to clarify the company's compliance posture in customer discussions.
    - Designed and developed a *security hardening program* for the On-Premise 3DEXPERIENCE Platform, delivered to an energy-sector customer (Java for source code, Rust for tests). The resulting health-checking tool:
      - Verifies *secure configuration baselines* (TLS versions and ciphers, sensitive HTTP headers, Referrer filtering, allowed methods, AJP listener checks).
      - Detects *known vulnerabilities in dependencies* against the customer's database.
      - Validates *security-critical components* and generates *audit-ready reports* with minimal runtime overhead.
    - Contributed to the *Customer Data Protection* 3DS initiative, supporting the EUROWEST team in better managing sensitive customer data.
    - Maintained and improved internal documentation describing the Dassault Systèmes licensing mechanism (On-Premise and Cloud).
    - Performed installations and validation testing of the 3DEXPERIENCE Platform (releases 23x to 26x) on Oracle Linux VMs, including License Server deployments for partner trainings, customer demonstrations (e.g. Airbus, Naval Group), and internal POCs.
  ]
)
